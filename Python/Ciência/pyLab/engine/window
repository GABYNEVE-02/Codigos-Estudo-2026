import pygame

class Window:
    def __init__(self):
        
        pygame.init()

        
        self.screen = pygame.display.set_mode((1800, 1000))
        pygame.display.set_caption("GTA 6")
        self.clock = pygame.time.Clock()
        self.running = True
        
    def run(self):
        while self.running:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    self.running = False
            self.screen.fill((30, 30, 30))  # Fill the screen with black
            pygame.display.flip()  # Update the display
            self.clock.tick(60)  # Limit the frame rate to 60 FPS
            
        pygame.quit()
        
janela = Window()
janela.__init__()
janela.run()